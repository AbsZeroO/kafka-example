      "id": 1,
      "title": "Stan mikroserwisów",
      "type": "stat",
      "targets": [
        {
          "expr": "up{job=~\"order-service|notification-service\"}",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "title": "Żądania HTTP na sekundę",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (application, uri) (rate(http_server_requests_seconds_count{uri!=\"/actuator/prometheus\"}[1m]))",
          "legendFormat": "{{application}} {{uri}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "id": 3,
      "title": "Czas odpowiedzi HTTP (p95)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, application, uri) (rate(http_server_requests_seconds_bucket{uri!=\"/actuator/prometheus\"}[5m])))",
          "legendFormat": "{{application}} {{uri}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "id": 4,
      "title": "Pamięć JVM",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (application) (jvm_memory_used_bytes{area=\"heap\"})",
          "legendFormat": "{{application}} heap",
          "refId": "A"
        }
      ]
    }
